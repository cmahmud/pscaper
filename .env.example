# Required: public IPv4 or DNS name of this VPS.
PSCAPER_PUBLIC_HOST=203.0.113.10

# Conservative defaults for a 2-OCPU / 12-GB VPS. Increase only after observing load.
PSCAPER_WORKERS=600
PSCAPER_QUEUE_SIZE=100000
PSCAPER_TIMEOUT=6s
PSCAPER_SOURCE_CONCURRENCY=8

# Continuous-cycle mode: harvest -> validate queued work -> export/push -> harvest again.
# When a cycle finds no new/due work, a short adaptive backoff avoids hammering unchanged feeds.
PSCAPER_CONTINUOUS=true
PSCAPER_CYCLE_BACKOFF_MIN=5s
PSCAPER_CYCLE_BACKOFF_MAX=30s

# Retest cadence. The old timer values remain available if continuous mode is disabled.
PSCAPER_HARVEST_INTERVAL=5m
PSCAPER_ALIVE_RECHECK=5m
PSCAPER_DEAD_RECHECK=30m
PSCAPER_EXPORT_INTERVAL=10m
# Periodic point-in-time snapshots of current alive/gold combined lists.
PSCAPER_ARCHIVE_INTERVAL=1h
PSCAPER_FLUSH_INTERVAL=3s
PSCAPER_GOLD_SCORE=80

# Local management API. Keep this on loopback unless you intentionally secure/expose it.
PSCAPER_API_ADDR=127.0.0.1:8788

# Public probe listeners. Candidate proxies connect back to these to prove end-to-end forwarding.
PSCAPER_PROBE_HTTP_ADDR=:8787
PSCAPER_PROBE_HTTPS_ADDR=:8789
PSCAPER_PROBE_HTTP_PORT=8787
PSCAPER_PROBE_HTTPS_PORT=8789
PSCAPER_PROBE_TOKEN=REPLACED_BY_INSTALLER

# Paths are filled by install.sh.
PSCAPER_DATA_DIR=/home/ubuntu/pscaper/data
PSCAPER_SOURCES=/home/ubuntu/pscaper/config/sources.json
PSCAPER_EXPORT_DIR=/home/ubuntu/pscaper/exports

# Git push is attempted every export cycle (10m by default). Until setup-github.sh
# initializes the export directory as a private Git repo, status simply shows "not configured".
PSCAPER_GIT_PUSH=true
PSCAPER_GIT_REMOTE=origin
PSCAPER_GIT_BRANCH=main

# GitHub export setup. "public" is intended for a read-only public pool repository.
PSCAPER_GITHUB_VISIBILITY=public
# Leave blank to let setup-github.sh use the authenticated GitHub account and its ID-based noreply address.
PSCAPER_GIT_AUTHOR_NAME=
PSCAPER_GIT_AUTHOR_EMAIL=
