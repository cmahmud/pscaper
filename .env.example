# Public IP for callback probes, not a public management API.
PSCAPER_PUBLIC_HOST=203.0.113.10
# Conservative defaults for 2-core 12 GiB ARM64 instances.
PSCAPER_WORKERS=120
PSCAPER_QUEUE_SIZE=15000
PSCAPER_TIMEOUT=5s
PSCAPER_SOURCE_CONCURRENCY=6
PSCAPER_CONTINUOUS=false
PSCAPER_HARVEST_INTERVAL=15m
PSCAPER_ALIVE_RECHECK=15m
PSCAPER_DEAD_RECHECK=2h
PSCAPER_EXPORT_INTERVAL=5m
PSCAPER_ARCHIVE_INTERVAL=6h
PSCAPER_FLUSH_INTERVAL=45s
PSCAPER_GOLD_SCORE=80
# Management API always loopback; Nginx terminates only /probe/ on 80/443.
PSCAPER_API_ADDR=127.0.0.1:8788
PSCAPER_PROBE_HTTP_ADDR=127.0.0.1:8787
PSCAPER_PROBE_HTTPS_ADDR=127.0.0.1:8789
PSCAPER_PROBE_HTTP_PORT=80
PSCAPER_PROBE_HTTPS_PORT=443
PSCAPER_PROBE_TOKEN=CHANGE_ME_TO_LONG_RANDOM_TOKEN
# Every application/runtime path stays under the project.
PSCAPER_DATA_DIR=/home/ubuntu/pscaper/data
PSCAPER_SOURCES=/home/ubuntu/pscaper/config/sources.json
PSCAPER_EXPORT_DIR=/home/ubuntu/pscaper/exports
# Pool exports stay local unless the separate pool repo is authenticated.
PSCAPER_GIT_PUSH=false
PSCAPER_GIT_REMOTE=origin
PSCAPER_GIT_BRANCH=main
