[Unit]
Description=pscaper public-proxy feed validator
Documentation=https://github.com/cmahmud/pscaper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pscaper
EnvironmentFile=/home/ubuntu/pscaper/.env
ExecStart=/home/ubuntu/pscaper/bin/pscaper serve
Restart=on-failure
RestartSec=8
TimeoutStopSec=180
LimitNOFILE=131072
MemoryHigh=4G
MemoryMax=6G
CPUQuota=180%
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/pscaper
UMask=0027
StandardOutput=append:/home/ubuntu/pscaper/logs/pscaper.log
StandardError=append:/home/ubuntu/pscaper/logs/pscaper.log

[Install]
WantedBy=multi-user.target
