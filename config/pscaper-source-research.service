[Unit]
Description=Research public proxy sources for pscaper; generate report only
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pscaper
ExecStart=/usr/bin/python3 /home/ubuntu/pscaper/scripts/research-sources.py
TimeoutStartSec=900
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/pscaper
