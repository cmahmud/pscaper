[Unit]
Description=Check pscaper trusted Cloudflare edge CIDR list for changes
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pscaper
ExecStart=/usr/bin/python3 /home/ubuntu/pscaper/scripts/check-cloudflare-realip.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
