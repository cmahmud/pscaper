[Unit]
Description=Update pscaper IP-to-ASN country dataset
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pscaper
ExecStart=/home/ubuntu/pscaper/scripts/update-ipintel.sh
TimeoutStartSec=150
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/pscaper
